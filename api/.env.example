# Copy to .env for local runs. DEVOPS: never commit a real .env — staging and
# prod values should come from the deployment mechanism / a secret store.

LINKR_DATABASE_URL=postgresql+psycopg://linkr:linkr@localhost:5432/linkr
LINKR_BASE_URL=http://localhost:8000
LINKR_ENV=local
LINKR_LOG_LEVEL=info
LINKR_CORS_ORIGINS=*

# Set by the build pipeline, not by hand:
LINKR_VERSION=0.1.0
LINKR_GIT_SHA=unknown
